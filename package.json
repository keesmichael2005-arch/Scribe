{
  "name": "scribe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test": "NODE_ENV=development vitest run",
    "test:fast": "NODE_ENV=development vitest run && cargo test --manifest-path src-tauri/Cargo.toml --lib -- --test-threads=1",
    "test:unit": "NODE_ENV=development vitest run --environment node",
    "test:component": "NODE_ENV=development vitest run --environment jsdom --passWithNoTests"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^2.1.0"
  }
}
