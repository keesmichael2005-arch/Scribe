    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^4.1.9"
  }
