{
  "identifier": "onboarding",
  "description": "Capabilities for the onboarding wizard window",
  "windows": ["onboarding"],
  "permissions": [
    "core:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    {
      "identifier": "core:default",
      "allow": [
        { "command": "set_api_key_cmd" },
        { "command": "delete_api_key_cmd" },
        { "command": "has_api_key_cmd" }
      ]
    }
  ]
}
