{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Scribe Spike",
  "version": "0.0.0",
  "identifier": "dev.scribe.spike",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "spike",
        "url": "index.html",
        "width": 400,
        "height": 80,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
